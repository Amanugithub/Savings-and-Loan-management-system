# Copy to .env and fill in real values. Never commit the real .env.

# Supabase/Postgres connection string for the remote database this admin
# backend syncs to (see src/sync/, migrate-remote.js). Required for
# migrate:remote, the /api/sync routes, and db:compare-schemas' live checks.
DATABASE_URL=postgres://user:password@host:5432/database

# Signs and verifies administrator JWTs (backend/src/routes/auth.js). Use a
# long random value in production — anyone with this secret can mint valid
# admin tokens. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-value

# Optional. Defaults to 4000.
PORT=4000

# Optional. Where the local SQLite database file lives. Defaults to
# backend/local.db (relative to this package's root).
# LOCAL_DB_PATH=./local.db

# Optional. Set to "production" to enable stricter Postgres SSL handling
# (src/config/postgres.js) and non-verbose error responses.
# NODE_ENV=production
