# Copy to .env and fill in real values. Never commit the real .env.

# The same Postgres database the admin backend syncs to — this API only
# reads/writes that shared database, it has no database of its own.
DATABASE_URL=postgres://user:password@host:5432/database

# Signs and verifies member JWTs (src/routes/auth.js, src/middleware/
# memberAuth.js). Use a different value from the admin backend's
# JWT_SECRET — a member token must never be valid as an admin token.
# Generate one with: openssl rand -base64 48
MEMBER_JWT_SECRET=replace-with-a-long-random-value

# Optional. Defaults to 4001.
PORT=4001

# Optional. Set to "production" to enable stricter Postgres SSL handling
# and non-verbose error responses (src/middleware/errorHandler.js).
# NODE_ENV=production
